VITE_API_MODE=mock
VITE_API_BASE_URL=/api
VITE_ENABLE_QUERY_DEVTOOLS=false
VITE_REALTIME_POLL_MS=15000

# Set VITE_API_MODE=gateway and fill these in to use the real Supabase
# backend (see supabase/schema.sql) instead of the in-browser mock API.
# Both values are safe to commit to a private .env -- neither is a secret;
# find them in the Supabase dashboard under Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
